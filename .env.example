# Backend legacy usato dal proxy Vite in sviluppo.
# Usa l'indirizzo della macchina/server nella tua rete locale.
VITE_LEGACY_BACKEND=http://localhost:8080

# Produzione con backend separato: URL HTTPS completo.
# Produzione same-origin: lascia vuoto e imposta VITE_DEMO_MODE=false.
VITE_API_BASE_URL=

# true  = forza dati demo
# false = forza modalità reale/same-origin quando API_BASE_URL è vuoto
# vuoto = fallback automatico demo in build produzione senza backend URL
VITE_DEMO_MODE=
